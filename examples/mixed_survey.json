        "Under 10 minutes",
        "10 to 20 minutes",
        "20 to 30 minutes",
        "30 to 45 minutes",
        "45 to 60 minutes",
        "Over an hour",
        "It varies too much to say"
      ],
      "edsl_class_name": "QuestionBase"
    },
    {
      "question_name": "commute_enjoyment",
      "question_type": "likert_five",
